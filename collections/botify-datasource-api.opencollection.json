{
  "opencollection": "1.0.0",
  "info": {
    "name": "Botify Datasource API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Datasource",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "getDatasourcesSummaryByProjects",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.botify.com/v1/users/:username/datasources_summary_by_projects",
            "params": [
              {
                "name": "username",
                "value": "",
                "type": "path",
                "description": "User's identifier"
              }
            ]
          },
          "docs": "Get the datasources details for all projects of a user"
        }
      ]
    }
  ],
  "bundled": true
}