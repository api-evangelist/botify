{
  "opencollection": "1.0.0",
  "info": {
    "name": "Botify User API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "User",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "getUserProjects",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.botify.com/v1/projects/:username",
            "params": [
              {
                "name": "username",
                "value": "",
                "type": "path",
                "description": "User's identifier"
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Project's name"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page Number"
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "Page Size"
              }
            ]
          },
          "docs": "List all active projects for the user"
        }
      ]
    }
  ],
  "bundled": true
}