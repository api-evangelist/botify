        {
          "info": {
            "name": "launchAnalysisCreate",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.botify.com/v1/analyses/:username/:project_slug/create/launch",
            "params": [
              {
                "name": "username",
                "value": "",
                "type": "path",
                "description": "User's identifier"
              },
              {
                "name": "project_slug",
                "value": "",
                "type": "path",
                "description": "Project's identifier"
              }
            ]
          },
          "docs": "Create and launch an analysis for a project"
        },
        {
